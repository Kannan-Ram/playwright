{
  "name": "sac-test-automation-framework",
  "version": "1.0.0",
  "description": "Comprehensive Playwright test automation framework for SAP Analytics Cloud (SAC)",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test tests/e2e",
    "test:integration": "playwright test tests/integration",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:safari": "playwright test --project=webkit",
    "test:edge": "playwright test --project=edge",
    "test:mobile": "playwright test --project=mobile",
    "test:parallel": "playwright test --workers=4",
    "test:sequential": "playwright test --workers=1",
    "test:slow": "playwright test --grep @slow",
    "test:update-snapshots": "playwright test --update-snapshots",
    "report": "playwright show-report",
    "report:html": "playwright show-report html-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "type-check": "tsc --noEmit",
    "pretest": "npm run type-check",
    "prepare": "npx playwright install",
    "clean": "rm -rf test-results reports screenshots allure-results allure-report",
    "clean:install": "rm -rf node_modules package-lock.json && npm install"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "sap",
    "analytics-cloud",
    "e2e",
    "typescript"
  ],
  "author": "Test Automation Team",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.48.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.4",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "allure-playwright": "^3.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.6.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
