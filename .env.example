# Environment Configuration
ENVIRONMENT=dev
# Options: dev, staging, prod

# Application URLs
BASE_URL=https://sac-dev.example.com
API_BASE_URL=https://api-dev.sac.example.com

# Test Credentials
TEST_USERNAME=test.user@example.com
TEST_PASSWORD=TestPassword123
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=AdminPassword123

# API Authentication
API_TOKEN=your-api-token-here

# Timeouts (in milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=15000

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug, verbose

# Test Execution
HEADLESS=false
SLOW_MO=0
WORKERS=4
RETRIES=1

# Screenshots & Videos
TAKE_SCREENSHOTS=true
RECORD_VIDEO=false
SCREENSHOT_ON_FAILURE=true

# Storage State
STORAGE_STATE_PATH=.auth/user.json

# Cleanup
CLEAN_OLD_SCREENSHOTS=false
CLEAN_OLD_RESULTS=false

# Notifications
SEND_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL=

# CI/CD
CI=false
ARCHIVE_RESULTS=false

# Feature Flags
ENABLE_MOCK_DATA=false
ENABLE_DEBUG_MODE=false
ENABLE_TRACING=true
